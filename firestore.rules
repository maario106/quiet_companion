rules_version = '2';

// /users es privado: cada usuario lee su documento y el de su vinculado.
// La vinculación la escribe la callable validateAndLink con el Admin SDK.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Campos cuyo valor cambia en esta escritura, aunque se reenvíe el documento entero.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // get(campo, null): leer con punto un campo ausente deniega la operación.
    function companionOf() {
      return resource.data.get('linkedCompanionId', null);
    }

    // El familiar que ya está vinculado a ESTE mayor.
    function isLinkedCompanion() {
      return isSignedIn() && companionOf() == request.auth.uid;
    }

    // Campos que solo escribe el servidor (el consentimiento, vía setConversationConsent).
    function serverOnlyFields() {
      return ['conversationConsent'];
    }

    // Requiere consentimiento vigente y un nivel de companionSharing que lo incluya.
    function companionMayRead(elderId, levels) {
      let elder = get(/databases/$(database)/documents/users/$(elderId)).data;
      return isSignedIn()
        && elder.get('linkedCompanionId', null) == request.auth.uid
        && elder.get('conversationConsent', {}).get('granted', false) == true
        && elder.get('companionSharing', 'none') in levels;
    }

    match /users/{userId} {

      // Solo por id: el dueño o el familiar vinculado.
      allow get: if isOwner(userId) || isLinkedCompanion();

      // Nadie enumera /users; la búsqueda por código corre en validateAndLink.
      allow list: if false;

      // Alta del propio documento, sin consentimiento previo.
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(serverOnlyFields());

      allow delete: if false;

      allow update: if
        // 1. El dueño: todo salvo los campos de servidor.
        (isOwner(userId) && !changed().hasAny(serverOnlyFields()))

        // 2. El familiar vinculado: solo preferencias, nombre y plazos de conversación.
        || (isLinkedCompanion()
            && changed().hasOnly(['preferences', 'name', 'conversationSettings']))

        // La vinculación no está aquí: la escribe validateAndLink con el Admin SDK.
        ;

      // Análisis de conversaciones: solo los escribe closeConversation (Admin SDK).
      // "Cómo se encuentra": actividad, ánimo y señales.
      match /conversations/{conversationId} {
        allow read: if isOwner(userId)
          || companionMayRead(userId, ['wellbeing', 'full']);
        allow write: if false;
      }
      // "De qué habláis": temas y resúmenes.
      match /conversationContents/{conversationId} {
        allow read: if isOwner(userId) || companionMayRead(userId, ['full']);
        allow write: if false;
      }
      // Lo que el asistente recuerda del mayor.
      match /memory/{docId} {
        allow read: if isOwner(userId) || companionMayRead(userId, ['full']);
        allow write: if false;
      }
    }

    // Todo lo demás, denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
