rules_version = '2';

// Reglas de Quiet Companion.
//
// Modelan lo que el código hace HOY, no lo que se querría que hiciera. Cada
// permiso de abajo corresponde a una operación concreta de
// `auth_repository.dart` o `dashboard_controller.dart`; si una de esas
// operaciones cambia, estas reglas la denegarán en silencio y la app enseñará
// "Error al guardar". Los tests de `firestore-tests/` existen para que eso se
// vea al ejecutar y no en el móvil de un mayor.
//
// `/users` es privado: cada uno ve su documento y el de su vinculado, y nada
// más. La vinculación ya no necesita consultar la colección — la hace la
// callable `validateAndLink` con credenciales de servidor (RNF-9, ADR-0008).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Campos que cambian de valor en esta escritura. Un `set()` que reenvía el
    // documento entero pero solo altera un campo produce una sola clave aquí:
    // por eso `saveUser` del panel del familiar pasa el filtro de abajo pese a
    // reescribir el documento completo.
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Lectura defensiva con `get(campo, null)`: en estas reglas, leer con
    // notación de punto un campo ausente deniega la operación entera, y
    // `linkedCompanionId` no existe hasta que hay vínculo.
    function companionOf() {
      return resource.data.get('linkedCompanionId', null);
    }

    // El familiar que ya está vinculado a ESTE mayor.
    function isLinkedCompanion() {
      return isSignedIn() && companionOf() == request.auth.uid;
    }

    // Campos que solo escribe el servidor con el Admin SDK. Hoy, el registro
    // del consentimiento: su hora es la del servidor porque es la prueba de
    // que el mayor consintió (ADR-0030, `setConversationConsent`).
    function serverOnlyFields() {
      return ['conversationConsent'];
    }

    // El familiar vinculado puede leer el análisis de su mayor solo si el
    // mayor lo consiente HOY y ha elegido un nivel que lo incluye (ADR-0031).
    // Se consulta el documento del mayor: la decisión es suya y vive allí.
    // Retirar el consentimiento cierra el acceso en el acto, aunque los datos
    // sigan existiendo durante el periodo de gracia (ADR-0030).
    function companionMayRead(elderId, levels) {
      let elder = get(/databases/$(database)/documents/users/$(elderId)).data;
      return isSignedIn()
        && elder.get('linkedCompanionId', null) == request.auth.uid
        && elder.get('conversationConsent', {}).get('granted', false) == true
        && elder.get('companionSharing', 'none') in levels;
    }

    match /users/{userId} {

      // ── Lectura ────────────────────────────────────────────────────────
      // Solo por identificador, y solo dos casos: el dueño lee su documento
      // (`getUser`, `watchUser`) y el familiar vinculado lee el de su mayor
      // (panel, `getUser(elderId)`).
      allow get: if isOwner(userId) || isLinkedCompanion();

      // Nadie consulta la colección. Buscar al mayor por su código era lo
      // único que lo exigía, y eso ahora corre en `validateAndLink` con
      // credenciales de servidor. Sin esta línea abierta, `/users` deja de
      // poder enumerarse desde un cliente.
      allow list: if false;

      // ── Escritura ──────────────────────────────────────────────────────
      // Alta del propio documento: mayor anónimo en el onboarding
      // (`saveUser`) y familiar en el registro (`ensureCompanionUserDoc`).
      // Nadie nace con un consentimiento que no ha dado.
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(serverOnlyFields());

      // El borrado de una cuenta es una acción explícita de datos, nunca un
      // efecto de la app. Si algún día hace falta, va por Cloud Function.
      allow delete: if false;

      allow update: if
        // 1. El dueño gobierna su documento: nombre, preferencias, contacto
        //    de emergencia y qué ve su familiar (`updateName`,
        //    `updatePreferences`, `updateEmergencyContact`,
        //    `updateCompanionSharing`). Todo menos su consentimiento, que solo
        //    cambia pasando por la callable.
        (isOwner(userId) && !changed().hasAny(serverOnlyFields()))

        // 2. El familiar vinculado solo toca lo que su panel edita:
        //    preferencias, nombre y plazos de la conversación (ADR-0034). No
        //    puede cambiar el rol del mayor, romperle el vínculo, reescribirle
        //    el contacto de emergencia, consentir por él ni decidir qué ve.
        || (isLinkedCompanion()
            && changed().hasOnly(['preferences', 'name', 'conversationSettings']))

        // 2b. La vinculación NO aparece aquí a propósito: la escribe
        //     `validateAndLink` con el Admin SDK, que se salta estas reglas.
        //     Un cliente no puede reclamar a un mayor por su cuenta, ni
        //     siquiera a uno con código libre.
        ;

      // ── Conversaciones analizadas (HU-5/HU-6) ───────────────────────────
      // Las escribe solo `closeConversation` con el Admin SDK: ningún cliente
      // crea, cambia ni borra un análisis (ADR-0029). La transcripción no
      // está en ninguna de ellas.
      // "Cómo se encuentra": actividad, ánimo y señales.
      match /conversations/{conversationId} {
        allow read: if isOwner(userId)
          || companionMayRead(userId, ['wellbeing', 'full']);
        allow write: if false;
      }
      // "De qué habláis": temas y resúmenes.
      match /conversationContents/{conversationId} {
        allow read: if isOwner(userId) || companionMayRead(userId, ['full']);
        allow write: if false;
      }
      // Lo que el asistente recuerda del mayor.
      match /memory/{docId} {
        allow read: if isOwner(userId) || companionMayRead(userId, ['full']);
        allow write: if false;
      }
    }

    // Todo lo demás, denegado. Cubre las colecciones que aún no existen: una
    // regla para algo que nadie escribe es una afirmación que nadie verifica.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
